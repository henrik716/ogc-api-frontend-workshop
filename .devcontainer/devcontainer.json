{
  "name": "OGC API workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "jupyter.kernels.excludePythonEnvironments": ["/usr/bin/python", "/usr/bin/python3", "/usr/local/bin/python", "/usr/local/bin/python3"],
        "workbench.editorAssociations": { "README.md": "vscode.markdown.preview.editor" }
      }
    },
    "codespaces": {
      "openFiles": ["README.md", "workshop.ipynb"]
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "OGC API", "onAutoForward": "notify" },
    "5001": { "label": "pygeoapi (internal)", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install --no-cache-dir ipykernel pyyaml pyproj"
}
