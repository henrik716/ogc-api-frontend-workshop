{
  "name": "OGC API workshop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "os-provided" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-toolsai.jupyter", "redhat.vscode-yaml"],
      "settings": { "python.defaultInterpreterPath": "/usr/bin/python3" }
    },
    "codespaces": {
      "openFiles": ["workshop.ipynb"]
    }
  },
  "forwardPorts": [3000, 5001],
  "portsAttributes": {
    "3000": { "label": "OGC API frontend", "onAutoForward": "notify" },
    "5001": { "label": "OGC API backend (pygeoapi)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "pip3 install --user --break-system-packages ipykernel pyyaml pyproj"
}
